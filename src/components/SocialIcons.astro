---
const site = 'https://www.xducraft.cn';
---
<a class="site-cta" href={site}>
  <span>前往官网</span>
  <svg class="site-cta__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
    <polyline points="15 3 21 3 21 9"></polyline>
    <line x1="10" y1="14" x2="21" y2="3"></line>
  </svg>
</a>
<style>
  .site-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    background: #3c8527;
    color: #fff !important;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    font-size: var(--sl-text-sm);
  }
  .site-cta:hover { background: #4aa330; }
  .site-cta__icon { flex: none; }
</style>
